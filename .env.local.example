# ==========================================
# KONFIGURASI SUPABASE (Wajib untuk Phase 0+)
# ==========================================
# Dapatkan dari: Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (HANYA untuk server-side/admin, JANGAN pernah expose ke client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# KONFIGURASI AI GEMINI (Untuk Phase 3)
# ==========================================
# Dapatkan gratis dari Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# ==========================================
# SEED DATA CONTOH (hanya di .env.staging.local, JANGAN di .env.local)
# ==========================================
# SEED_CONFIRM_STAGING=yes
# SEED_BLOCKED_PROJECT_REFS=ref-database-utama
